# Salin ke .env untuk pengembangan lokal. JANGAN pakai nilai ini di produksi.
ENVIRONMENT=development
LOG_LEVEL=debug
PORT=8080

DATABASE_URL=postgres://app_user:app_dev_pw@localhost:5432/platform
MAINTENANCE_DATABASE_URL=postgres://app_maintenance:maintenance_dev_pw@localhost:5432/platform
MIGRATION_DATABASE_URL=pgx5://app_migrator:migrator_dev_pw@localhost:5432/platform
REDIS_URL=redis://localhost:6379

SESSION_SECRET=dev-only-change-me-dev-only-change-me
COOKIE_NAME=platform_session
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
PUBLIC_BASE_URL=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=platform@localhost

STORAGE_PATH=./data/uploads
OTEL_EXPORTER_OTLP_ENDPOINT=

# /metrics Prometheus: port internal terpisah (0 = nonaktif). Jangan di-publish ke luar jaringan monitoring.
METRICS_PORT=9090
WORKER_METRICS_PORT=9091

# Hash password Argon2id (docs/05 §4.1). Setel ulang dengan benchmark di perangkat keras deploy
# (target 50–150 ms per hash). PASSWORD_HASH_CONCURRENCY=0 berarti jumlah CPU.
PASSWORD_ARGON2_MEMORY_KIB=65536
PASSWORD_ARGON2_TIME=3
PASSWORD_ARGON2_PARALLELISM=2
PASSWORD_HASH_CONCURRENCY=0
PASSWORD_MIN_LENGTH=12

# Sesi (docs/05 §12.1): idle = sejak aktivitas terakhir; absolut = sejak dibuat (tidak dapat diperpanjang).
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# Penjaga login (docs/05 §12.3, ADR-0020 bagian 5): LOGIN_MAX_FAILURES password salah dalam LOGIN_FAILURE_WINDOW
# mengunci akun LOGIN_LOCK_DURATION; kunci berulang berlipat dua sampai LOGIN_LOCK_MAX. Selama kunci aktif login
# selalu "email atau password salah" (kunci tak terlihat). LOGIN_IP_MAX_FAILURES kegagalan per IP (IPv6 per /64)
# dalam jendela yang sama menolak login dari IP itu (429). Pembuka kunci darurat: redis-cli DEL auth:lock:<user_id>
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCK_DURATION=15m
LOGIN_LOCK_MAX=60m
LOGIN_IP_MAX_FAILURES=30

# Port HOST compose (ADR-0021). Bawaan di bawah = port lama; tidak perlu diisi di mesin sendiri.
# Bila port bentrok (mis. VPS), JANGAN edit manual: `bash scripts/env-ports.sh POSTGRES=15432 REDIS=16379 API=18080 WEB=15173 SMTP=11025 MAILUI=18025`
# membuat .env yang konsisten (URL database/Redis, ALLOWED_ORIGINS, PUBLIC_BASE_URL, SMTP_PORT ikut berubah).
# POSTGRES_HOST_PORT, REDIS_HOST_PORT, API_HOST_PORT, WEB_HOST_PORT, MAILPIT_SMTP_HOST_PORT, MAILPIT_UI_HOST_PORT
# PORT di atas adalah port di DALAM container api: jangan diubah (compose memetakan host -> 8080).
