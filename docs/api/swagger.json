        "/api/v1/security/events": {
            "get": {
                "description": "Hanya event milik pemanggil, terbaru dulu, paginasi cursor (meta.pagination). Tidak ada parameter pengguna.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "security"
                ],
                "summary": "Riwayat event keamanan milik pengguna",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Jumlah baris (bawaan 50, maksimum 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Cursor dari meta.pagination.next_cursor",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.Envelope-array_backend_internal_auth_transport_http_SecurityEventView"
