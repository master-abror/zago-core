                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/switch-organization": {
            "post": {
                "description": "Hanya ke organisasi tempat pengguna menjadi anggota aktif. Token sesi dan token CSRF diganti.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Pindah organisasi aktif sesi",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Token CSRF sesi",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Organisasi tujuan",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/backend_internal_auth_transport_http.SwitchOrganizationRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.Envelope-backend_internal_auth_transport_http_SwitchOrganizationResponse"
