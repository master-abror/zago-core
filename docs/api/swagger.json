        "/api/v1/auth/refresh": {
            "post": {
                "description": "Mengganti cookie sesi dan token CSRF; idle clock mulai ulang, batas absolut sesi TIDAK bertambah (ADR-0020).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Ganti token sesi (rotasi)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Token CSRF sesi",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.Envelope-backend_internal_auth_transport_http_RefreshResponse"
