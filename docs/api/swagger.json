                        }
                    },
                    "401": {
                        "description": "authentication_required",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "/api/v1/security/password": {
            "post": {
                "description": "Memverifikasi password saat ini, menerapkan kebijakan password, mengganti hash, merotasi sesi saat ini (cookie dan csrf_token baru), dan mencabut semua sesi lain. Password saat ini yang salah = 401 invalid_credentials dan tidak ada yang berubah (sesi tetap berlaku). Tanpa Idempotency-Key (ADR-0020 butir 42).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "security"
                ],
                "summary": "Ganti password (pemanggil sendiri)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Token CSRF sesi",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Password saat ini dan password baru",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/backend_internal_auth_transport_http.ChangePasswordRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.Envelope-backend_internal_auth_transport_http_ChangePasswordResponse"
                        }
                    },
                    "400": {
                        "description": "validation_failed (new_password: too_short | too_long | same_as_current)",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    },
                    "401": {
                        "description": "authentication_required | invalid_credentials (password saat ini salah)",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    },
                    "403": {
                        "description": "csrf_failed",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    },
                    "429": {
                        "description": "rate_limit_exceeded",
                        "schema": {
                            "$ref": "#/definitions/github_com_master-abror_zago-core_backend_internal_kernel_httpx.ErrorEnvelope"
                        }
                    }
                }
            }
        },
